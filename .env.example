# Copy to .env and fill in what you use. Never commit .env.

# Which backend classifies events, and the model id it understands:
#   replay      recorded answers only, no key (the default)
#   openrouter  one key, many models: anthropic/claude-haiku-5.5, openai/gpt-5.6-luna, ...
#   openai      any OpenAI-compatible endpoint: OpenAI, vLLM, Together, Groq, ...
#   minimax     MiniMax-M3 (an OpenAI-compatible preset)
#   anthropic   Claude through the Anthropic SDK (structured outputs, prompt caching)
#   ollama      a local model, e.g. qwen3.5
PAC_BACKEND=replay
PAC_MODEL=MiniMax-M3
# A live model instead, for example through OpenRouter:
# PAC_BACKEND=openrouter
# PAC_MODEL=anthropic/claude-haiku-5.5

OPENROUTER_API_KEY=

OPENAI_API_KEY=
# PAC_OPENAI_BASE_URL=https://api.openai.com/v1
# Provider-specific request fields, as JSON:
# PAC_OPENAI_EXTRA_BODY={"reasoning_effort": "low"}

MINIMAX_API_KEY=
# PAC_MINIMAX_BASE_URL=https://api.minimax.io/v1
# PAC_MINIMAX_THINKING=disabled

ANTHROPIC_API_KEY=
# PAC_OLLAMA_HOST=http://localhost:11434

# Live conversation (pac serve --live): the model that plays the simulated agent, Lark.
# Unset, PAC_MODEL plays both Lark and the guardrail.
# PAC_AGENT_MODEL=

# Logs (stderr): DEBUG | INFO | WARNING | ERROR, and text | json
# PAC_LOG_LEVEL=INFO
# PAC_LOG_FORMAT=text
